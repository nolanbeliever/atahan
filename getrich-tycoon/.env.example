# GetRich Tycoon environment variables. Copy to .env for local development.
# NEVER commit a real .env file.

# HTTP/WebSocket port. Most hosts inject PORT automatically.
PORT=3000

# "development" | "production" | "test"
NODE_ENV=development

# PostgreSQL connection string. When empty the server falls back to a local SQLite file
# (SQLITE_PATH) which is intended for local development only.
DATABASE_URL=
# Set to "true" when your managed Postgres requires TLS and the URL has no sslmode (Render external URLs, Supabase...).
# Neon URLs already contain sslmode=require.
DATABASE_SSL=false

# SQLite fallback file used when DATABASE_URL is empty.
SQLITE_PATH=./data/getrich.db

# Comma separated list of allowed browser origins for Socket.IO/CORS.
# Leave empty when the client is served by this same server (recommended).
CORS_ORIGINS=

# Trust X-Forwarded-For for per-IP limits. Enable ONLY when the server is reachable exclusively through
# a reverse proxy that appends the header (Northflank, Caddy...). Default: false, but on when RENDER=true.
TRUST_PROXY=false

# Server simulation/network tick rate (Hz)
TICK_RATE=20

# Autosave interval in seconds (positions, fuel, mileage). Transactions are always saved immediately.
AUTOSAVE_SECONDS=30

# Login/register attempts allowed per IP per minute (brute-force protection).
AUTH_RATE_PER_MINUTE=10

# New accounts allowed per IP per hour, and across the whole server per hour.
REGISTER_PER_HOUR=10
REGISTER_GLOBAL_PER_HOUR=500

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Only used by the Vite dev server/client build when the client is hosted on a different origin
# than the game server (e.g. https://getrich-api.example.com). Leave empty for same-origin.
VITE_SERVER_URL=
